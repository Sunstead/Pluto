# ── Caddy ─────────────────────────────────────────────────
# Jupiter's Tailscale IPv4, where every public site is proxied to.
#   tailscale ip -4 jupiter     (from any tailnet device)
# Same address as "jupiter" in docs/tailnet-policy.hujson.
JUPITER_TS_IP=100.64.0.1

# ── CrowdSec ──────────────────────────────────────────────
# The key Caddy's bouncer uses with CrowdSec's local API. CrowdSec registers
# a bouncer called "caddy" with it on first start. Generate:
#   openssl rand -hex 32
# Changing it later: docs/RUNBOOK.md, "Rotate the bouncer key".
CROWDSEC_BOUNCER_KEY=change_me_crowdsec_bouncer_key

# ── Cosmos agent ──────────────────────────────────────────
# Group that owns /var/run/docker.sock: stat -c '%g' /var/run/docker.sock
DOCKER_GID=change_me_docker_gid

# ── ntfy ──────────────────────────────────────────────
# Accounts for compose/notify.yml, applied at every start. Hashes go in single
# quotes so Compose leaves their $ signs alone. Make each hash with:
#   docker run --rm -it binwiederhier/ntfy:v2.28.0 user hash
# NTFY_PHONE_HASH is the password you type into the ntfy app (keep it in your
# password manager); the two agents' hashes are of long random passwords
# nobody needs, since the agents publish by token.
NTFY_PHONE_HASH='change_me_bcrypt_hash'
NTFY_JUPITER_HASH='change_me_bcrypt_hash'
NTFY_PLUTO_HASH='change_me_bcrypt_hash'
# The agents' tokens, one per node, pasted into each node's channel in Cosmos
# (Settings > Notifications). Generate each with:
#   echo "tk_$(openssl rand -hex 16 | cut -c1-29)"
NTFY_JUPITER_TOKEN=tk_change_me_jupiter_token_00000
NTFY_PLUTO_TOKEN=tk_change_me_pluto_token_0000000

# ── Server ────────────────────────────────────────────────
# Time zone for container logs. Same value as Jupiter's, if it sets one.
TZ=Etc/UTC
