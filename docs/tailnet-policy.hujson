// The tailnet policy (Tailscale admin console > Access controls), kept here so
// it's reviewed like everything else. Paste the whole file over the default
// policy, with Jupiter's Tailscale IP filled in below. The admin console is
// what's live: change this file and the console together.
//
// Before: the default, every device reaches every device. After: your own
// devices still reach everything; Pluto, the public edge, reaches Jupiter's
// Caddy and Lodestone's game ports, and nothing else. If Pluto were ever
// taken over, that's all the tailnet it gets.
{
	"tagOwners": {
		// Pluto joins with a pre-approved, single-use auth key carrying this
		// tag (scripts/bootstrap.sh). Tagged devices don't expire.
		"tag:pluto": ["autogroup:admin"],
	},

	"hosts": {
		// Jupiter's Tailscale IPv4 (this one's a placeholder):
		// `tailscale ip -4 jupiter`. The same value as JUPITER_TS_IP in .env.
		"jupiter": "100.64.0.1",
	},

	"grants": [
		// Your devices: everything, as before. That includes SSH to Pluto and
		// its Helion agent (https://pluto.<tailnet>.ts.net:7700).
		// If you share Jupiter with people outside the tailnet, add
		// "autogroup:shared" to src, or they lose access.
		{"src": ["autogroup:member"], "dst": ["*"], "ip": ["*"]},

		// Pluto: Jupiter's Caddy, and Lodestone's game ports. The public
		// sites, plus Pluto's Helion agent fetching Authentik's keys, all go
		// through Caddy. (ntfy runs on Pluto itself.) The game ports reach
		// Minecraft servers only: RCON listens on Jupiter's 127.0.0.1, and the
		// range is LODESTONE_GAME_PORTS on both machines.
		{"src": ["tag:pluto"], "dst": ["jupiter"], "ip": ["tcp:443", "tcp:25565-25599"]},
	],

	// Tailscale SSH, unchanged from the default. Pluto uses plain OpenSSH
	// over the tailnet instead, so this doesn't cover it.
	"ssh": [
		{
			"action": "check",
			"src":    ["autogroup:member"],
			"dst":    ["autogroup:self"],
			"users":  ["autogroup:nonroot", "root"],
		},
	],

	// Checked by the admin console on every save.
	"tests": [
		{
			"src":    "tag:pluto",
			"proto":  "tcp",
			"accept": ["jupiter:443", "jupiter:25565", "jupiter:25599"],
			// SSH, plain HTTP, Jupiter's Helion agent, Lodestone itself, and
			// the ports either side of the game range. 25600 is where Lodestone
			// puts the first server's RCON (outside the range, and on
			// Jupiter's 127.0.0.1 besides).
			"deny": ["jupiter:22", "jupiter:80", "jupiter:7700", "jupiter:7878", "jupiter:25564", "jupiter:25600"],
		},
		{
			// Game ports are TCP only: no UDP (Minecraft's query).
			"src":    "tag:pluto",
			"proto":  "udp",
			"deny":   ["jupiter:25565"],
		},
	],
}
